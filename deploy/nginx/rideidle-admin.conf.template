# RideIdle: the admin panel, on a host of its own (admin.<domain>), so that its cookies are not the game's and it can be shut off by name.
#
#   everything   Laravel, through PHP-FPM (the panel is the whole of this host), except the files of the panel, which are served as they are
#
# This is a template: admin-site.sh puts the host, the folder of the application and the version of PHP in place of __ADMIN_DOMAIN__,
# __APP_DIR__ and __PHP_VERSION__ and writes it to /etc/nginx/sites-available/rideidle-admin.conf. The site of the game is not touched.
#
# To let only some addresses in, add `allow 203.0.113.7; deny all;` to the server block below (before the locations).

# Plain HTTP only answers the check of Let's Encrypt and sends everything else to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name __ADMIN_DOMAIN__;

    server_tokens off;

    access_log /var/log/nginx/rideidle-admin.access.log rideidle;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __ADMIN_DOMAIN__;

    server_tokens off;
    limit_req_status 429;

    ssl_certificate     /etc/letsencrypt/live/__ADMIN_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ADMIN_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/rideidle-security.conf;

    # The files of the panel (its styles and scripts, which the release puts in api/public) are served from here, and every other address is Laravel.
    # `current` is a link to the release that is live; $realpath_root follows it, so PHP's opcache sees a new release as new files.
    root __APP_DIR__/current/api/public;
    index index.php;

    client_max_body_size 2m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/rideidle-admin.access.log rideidle;
    error_log  /var/log/nginx/rideidle-admin.error.log warn;

    location / {
        try_files $uri /index.php?$query_string;
    }

    # The only script that runs is index.php. Checking a pack runs the pipeline of the game for a few seconds, so this waits longer than the API does.
    location = /index.php {
        limit_req zone=rideidle_api burst=40 nodelay;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php__PHP_VERSION__-fpm.sock;
        fastcgi_read_timeout 120s;
    }

    location ~ \.php$ {
        return 404;
    }

    # Nothing that starts with a dot is for the world, but the proof for Let's Encrypt.
    location ~ /\.(?!well-known) {
        deny all;
    }
}
