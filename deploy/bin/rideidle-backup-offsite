#!/usr/bin/env bash
# Sends the newest copy of the database of RideIdle to another place, so that the game survives the loss of this server. provision.sh installs this as
# /usr/local/sbin/rideidle-backup-offsite and runs it every night from /etc/cron.d/rideidle-backup, after the copy is made. It does nothing until BACKUP_REMOTE is set.
#
# The settings are in /etc/rideidle/backup.env (a file of KEY=value lines, readable by root only):
#
#   BACKUP_REMOTE=user@backup-host:/path/rideidle        where the copies go (rsync over ssh); empty: not configured
#   BACKUP_SSH_KEY=/root/.ssh/rideidle-backup            the key that is allowed to write there (no passphrase: cron has nobody to ask)
#   BACKUP_PASSPHRASE_FILE=/etc/rideidle/backup.pass     encrypt the copy first (AES-256, openssl). Recommended: a copy holds e-mail addresses and the whole game.
#                                                        Keep the passphrase somewhere else too; without it the copy cannot be opened.
#
# Opening an encrypted copy:   openssl enc -d -aes-256-cbc -pbkdf2 -in FILE.dump.enc -out FILE.dump -pass file:/etc/rideidle/backup.pass
# The old copies at the other end are not removed from here: that is for whoever runs that end (a copy a night is a few megabytes).
#
# Settings (environment): BACKUP_CONF (/etc/rideidle/backup.env), BACKUP_DIR, DB_NAME.

set -Eeuo pipefail

CONF="${BACKUP_CONF:-/etc/rideidle/backup.env}"
DIR="${BACKUP_DIR:-/var/backups/rideidle}"
DB_NAME="${DB_NAME:-rideidle}"

if [[ -r "$CONF" ]]; then
    # shellcheck disable=SC1090
    . "$CONF"
fi

BACKUP_REMOTE="${BACKUP_REMOTE:-}"
BACKUP_SSH_KEY="${BACKUP_SSH_KEY:-}"
BACKUP_PASSPHRASE_FILE="${BACKUP_PASSPHRASE_FILE:-}"

if [[ -z "$BACKUP_REMOTE" ]]; then
    echo "rideidle-backup-offsite: not configured, so nothing was sent (set BACKUP_REMOTE in $CONF)"
    exit 0
fi

newest="$(find "$DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"

if [[ -z "$newest" ]]; then
    echo "rideidle-backup-offsite: FAILED: there is no copy in $DIR" >&2
    exit 1
fi

umask 077
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

send="$newest"

if [[ -n "$BACKUP_PASSPHRASE_FILE" ]]; then
    [[ -r "$BACKUP_PASSPHRASE_FILE" ]] || { echo "rideidle-backup-offsite: FAILED: cannot read $BACKUP_PASSPHRASE_FILE" >&2; exit 1; }
    send="$work/$(basename "$newest").enc"
    openssl enc -aes-256-cbc -pbkdf2 -salt -in "$newest" -out "$send" -pass "file:$BACKUP_PASSPHRASE_FILE"
else
    echo "rideidle-backup-offsite: warning: BACKUP_PASSPHRASE_FILE is not set, so the copy is sent as it is (it holds personal data)" >&2
fi

ssh_command="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
[[ -z "$BACKUP_SSH_KEY" ]] || ssh_command="$ssh_command -i $BACKUP_SSH_KEY"

if ! rsync -a --chmod=F600 -e "$ssh_command" "$send" "$BACKUP_REMOTE/"; then
    echo "rideidle-backup-offsite: FAILED: could not send $(basename "$send") to $BACKUP_REMOTE" >&2
    exit 1
fi

echo "rideidle-backup-offsite: sent $(basename "$send") ($(du -h "$send" | cut -f1)) to $BACKUP_REMOTE"
